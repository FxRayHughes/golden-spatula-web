# 复制为 .env 后填写（.env 已在 .gitignore 中，不会上传）
# 站长账号：启动时自动创建/同步；口令至少 12 位
ADMIN_USER=admin
ADMIN_PASSWORD=

# 国内网络连不上 Docker Hub / gcr.io 时使用镜像站；能直连时删掉这两行
DOCKERHUB=docker.m.daocloud.io
GCR=gcr.m.daocloud.io

# 宿主机监听地址与端口；只给反向代理用时设 HOST_BIND=127.0.0.1
HOST_BIND=0.0.0.0
HOST_PORT=8788
# 放在反向代理后面时设为 1
TRUST_PROXY=0
